[Unit]
Description=Out-of-band Feishu gateway watchdog
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/feishu-dify-gateway
EnvironmentFile=-/etc/feishu-gateway-watchdog/config
ExecStart=/srv/feishu-dify-gateway/.venv/bin/python /srv/feishu-dify-gateway/cloud/watchdog.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=feishu-gateway-watchdog
StateDirectoryMode=0700
ReadWritePaths=/var/lib/feishu-gateway-watchdog
