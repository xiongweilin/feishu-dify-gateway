# Deployment-owned runtime configuration. Keep the real gateway hostname and
# SMTP host in the server-side EnvironmentFile, not in Git.
RELAY_GATEWAY_URL=http://gateway.example.internal:8082/v1/notifications
WATCHDOG_READY_URL=http://gateway.example.internal:8082/readyz
WATCHDOG_SMTP_HOST=smtp.example.internal
WATCHDOG_SMTP_PORT=587
