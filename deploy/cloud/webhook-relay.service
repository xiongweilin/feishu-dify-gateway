[Unit]
Description=Durable infrastructure webhook relay to Feishu gateway
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/srv/feishu-cloud-gateway
Environment=PYTHONUNBUFFERED=1
Environment=RELAY_QUEUE_DIR=/var/lib/feishu-webhook-relay/queue
EnvironmentFile=-/etc/feishu-relay/config
ExecStart=/srv/feishu-cloud-gateway/.venv/bin/python /srv/feishu-cloud-gateway/cloud/relay.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=feishu-webhook-relay
StateDirectoryMode=0700
ReadWritePaths=/var/lib/feishu-webhook-relay

[Install]
WantedBy=multi-user.target
